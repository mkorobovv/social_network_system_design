@startuml
!theme aws-orange
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

Person(user, "User")
Container(loadBalancer, "Load Balancer", "Nginx", "Uses round robin")
Container(reactionsQueue, "Reactions Queue", "Apache Kafka", "Stores reaction events [created, deleted, updated]", $tags="messageQueue")

System_Boundary(reactionsSystem, "Reactions system") {
    Container(reactionsService, "Reactions Service", "Go", "Handles creation, deletion of reactions", $tags="webApp")
    ContainerDb(reactionsDatabase, "Reactions Database", "PostgreSQL", "Stores reactions information",  $tags="db")
}

System_Boundary(externalSystem, "External system") {
    Container(postsSystem, "Posts System", "Software system")
}

Rel(user, loadBalancer, "CRUD operations with reactions", "REST")
Rel(loadBalancer, reactionsService, "CRUD operations with reactions", "REST")
Rel(reactionsQueue, postsSystem, "Consumes reaction events")
Rel(reactionsService, reactionsQueue, "Produces reaction events")
Rel(reactionsService, reactionsDatabase, "Stores created posts information")
@enduml